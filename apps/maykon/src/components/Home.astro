---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Rail from './Rail.astro';
import Chapter from './Chapter.astro';
import PwmLab from './games/PwmLab.astro';
import MqttBench from './games/MqttBench.astro';
import ClusterLab from './games/ClusterLab.astro';
import GanLab from './games/GanLab.astro';
import LedgerLab from './games/LedgerLab.astro';
import IndexLab from './games/IndexLab.astro';
import BoardLab from './games/BoardLab.astro';
import PartLab from './games/PartLab.astro';
import SystemTrace from './games/SystemTrace.astro';
import GlassLab from './games/GlassLab.astro';
import FlowLab from './games/FlowLab.astro';
import SplatLab from './games/SplatLab.astro';
import Record from './Record.astro';
import type { Locale } from '../content';
import { content } from '../content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = content[locale];
// The eyebrow reads "12 · RECORD". Both halves come from it, so adding a
// chapter renumbers the rail without anyone having to remember to.
const [recordNumber, recordCodename] = c.record.eyebrow.split('·').map((part) => part.trim());
---
<Base locale={locale} title={c.meta.title} description={c.meta.description}>
  <Hero hero={c.hero} />
  <Rail chapters={c.chapters} extra={{ id: recordNumber, codename: recordCodename, slug: 'record' }} />

  <main id="chapters">
    {c.chapters.map((chapter) => (
      <>
      {c.acts.filter((a) => a.before === chapter.slug).map((act) => (
        <div class="act">
          <div class="act__inner">
            <p class="act__label mono">{act.label}</p>
            <h2 class="act__title">{act.title}</h2>
            <p class="act__lede">{act.lede}</p>
          </div>
        </div>
      ))}
      <Chapter chapter={chapter} learned={c.ui.learned}>
        {chapter.slug === 'silicon' ? (
          <PwmLab ui={c.ui} />
        ) : chapter.slug === 'signal' ? (
          <MqttBench signal={c.signal} />
        ) : chapter.slug === 'swarm' ? (
          <ClusterLab swarm={c.swarm} />
        ) : chapter.slug === 'mind' ? (
          <GanLab mind={c.mind} />
        ) : chapter.slug === 'service' ? (
          <IndexLab service={c.service} />
        ) : chapter.slug === 'copper' ? (
          <BoardLab copper={c.copper} />
        ) : chapter.slug === 'steel' ? (
          <PartLab steel={c.steel} />
        ) : chapter.slug === 'glass' ? (
          <GlassLab glass={c.glass} />
        ) : chapter.slug === 'ledger' ? (
          <LedgerLab ledger={c.ledger} />
        ) : chapter.slug === 'flow' ? (
          <FlowLab flow={c.flow} />
        ) : chapter.slug === 'field' ? (
          <SplatLab field={c.field} />
        ) : chapter.slug === 'system' ? (
          <SystemTrace system={c.system} chapters={c.chapters} />
        ) : (
          <div class="wip">
            <span>{c.ui.wip}</span>
            <span style="color: var(--fg-700)">{c.ui.wipNote}</span>
          </div>
        )}
      </Chapter>
      </>
    ))}

    <Record record={c.record} />
  </main>
</Base>
