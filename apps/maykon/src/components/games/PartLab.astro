---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { Content } from '../../content';

interface Props { steel: Content['steel'] }
const { steel } = Astro.props;

// The meshes are served from public/, so the bundler never fingerprints them —
// and the deploy marks everything that is not HTML immutable for a year. Without
// a version in the URL a returning visitor would be stuck with the old file
// forever. Hash the contents at build time instead.
// Resolved from the app root rather than from import.meta.url: this component
// is bundled into dist/chunks/, where a relative path no longer points at public/.
const modelPath = join(process.cwd(), 'public/models/agrom-parts.json');
const modelVersion = createHash('sha256').update(readFileSync(modelPath)).digest('hex').slice(0, 8);
---
<div class="st" data-st data-loading={steel.loading} data-parts-copy={JSON.stringify(steel.parts)} data-model-version={modelVersion}>
  <p class="st__lede">{steel.lede}</p>

  <figure class="st__assembly">
    <img class="st__hero" src="/img/agrom-station.jpg" alt={steel.assemblyAlt}
      width="546" height="1120" loading="lazy" decoding="async" />
    <figcaption class="mono">{steel.assemblyCaption}</figcaption>
  </figure>

  <div class="st__details">
    <figure>
      <img src="/img/agrom-head.jpg" alt={steel.detailHeadAlt}
        width="546" height="1120" loading="lazy" decoding="async" />
      <figcaption class="mono">{steel.detailHeadCaption}</figcaption>
    </figure>
    <figure>
      <img src="/img/agrom-sensor.jpg" alt={steel.detailSensorAlt}
        width="959" height="682" loading="lazy" decoding="async" />
      <figcaption class="mono">{steel.detailSensorCaption}</figcaption>
    </figure>
  </div>

  <h3 class="st__ptitle st__ptitle--parts">{steel.partsTitle}</h3>
  <p class="st__plede">{steel.partsLede}</p>

  <div class="st__row">
    <span class="st__rowlabel mono">{steel.partsLabel}</span>
    <div class="st__chips" data-parts>
      <span class="st__loading mono" data-loadnote>{steel.loading}</span>
    </div>
  </div>

  <div class="st__stage" data-stage>
    <canvas class="st__canvas" data-canvas width="1000" height="640"
      role="img" aria-label="A 3D-printed part from the AGROM.IO probe"></canvas>
      <p class="st__caption">
      <b data-part-name></b><span data-part-kind></span>
      <span class="st__blurb" data-part-blurb></span>
    </p>
  </div>

  <div class="st__bar">
    <button type="button" class="btn" data-spin aria-pressed="true">↻ {steel.autoSpin}</button>
    <span class="st__spin mono">↔ {steel.spin}</span>
  </div>

  <div class="readout">
    <div class="readout__cell">
      <span class="readout__k">{steel.span}</span>
      <span class="readout__v" data-out="mm">—</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{steel.triangles}</span>
      <span class="readout__v" data-out="tris">—</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{steel.sourceTris}</span>
      <span class="readout__v" data-out="src">—</span>
    </div>
  </div>

  <p class="st__hint">{steel.hint}</p>

  <div class="st__process">
    <h3 class="st__ptitle">{steel.processTitle}</h3>
    <p class="st__plede">{steel.processLede}</p>
    <ul class="st__plist">
      {steel.processes.map((p) => (
        <li class="st__pitem">
          <span class="st__pcount mono">{p.count}</span>
          <span class="st__pbody">
            <b>{p.label}</b>
            <span class="st__pnote">{p.note}</span>
          </span>
        </li>
      ))}
    </ul>
    <p class="st__drawings mono">{steel.drawings}</p>
  </div>
</div>

<style>
  .st__lede { color: var(--fg-500); font-size: var(--step--1); margin: 0 0 1.5rem; max-width: 74ch; }

  .st__assembly { margin: 0 0 1rem; display: grid; justify-items: center; gap: .8rem; }
  /* The station render is a tall portrait: bound it by height, not by width. */
  .st__hero {
    max-height: min(62vh, 560px); width: auto; max-width: 100%;
    border-radius: 10px; border: 1px solid var(--line);
  }
  .st__details {
    display: grid; gap: 1rem; margin-bottom: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    align-items: end;
  }
  .st__details figure { margin: 0; display: grid; justify-items: center; gap: .6rem; }
  .st__details img {
    max-height: 260px; width: auto; max-width: 100%;
    border-radius: 8px; border: 1px solid var(--line);
    /* The sensor render was flattened against this colour; the seam disappears. */
    background: #08090c;
  }
  .st__assembly figcaption, .st__details figcaption {
    font-size: 10px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--fg-700); text-align: center; max-width: 46ch;
  }
  .st__ptitle--parts { margin-top: 2.5rem; padding-top: 1.75rem; border-top: 1px solid var(--line); }

  .st__row { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin-bottom: 1rem; }
  .st__rowlabel { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fg-700); min-width: 4rem; }
  .st__chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .st__chips .btn { font-size: 11px; padding: .3rem .6rem; }
  .st__loading { font-size: 11px; color: var(--fg-700); }

  .st__stage { position: relative; background: #06070a; border: 1px solid var(--line); border-radius: 8px; display: grid; place-items: center; }
  .st__canvas { width: min(100%, 560px); height: auto; display: block; cursor: grab; touch-action: pan-y; }
  .st__canvas:active { cursor: grabbing; }
  .st__caption {
    margin: 0; padding: 0 1rem 1rem; text-align: center;
    font-size: var(--step--1); color: var(--fg-500); min-height: 2.6em; max-width: 46ch;
  }
  .st__caption b { color: var(--fg-100); font-weight: 600; display: block; }
  .st__blurb { display: block; margin-top: .15rem; }

  .st__bar { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 1rem; }
  .st__spin { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fg-700); }
  .st__hint { margin-top: 1rem; font-size: var(--step--1); color: var(--fg-700); max-width: 74ch; }

  .st__process { margin-top: 2.5rem; padding-top: 1.75rem; border-top: 1px solid var(--line); }
  .st__ptitle { font-size: var(--step-1); margin-bottom: .4rem; }
  .st__plede { color: var(--fg-300); font-size: var(--step--1); margin: 0 0 1.25rem; max-width: 70ch; }
  .st__plist { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .st__pitem { display: flex; align-items: baseline; gap: .9rem; }
  .st__pcount {
    min-width: 2.4rem; text-align: right;
    font-size: var(--step-1); color: var(--brand-500); font-variant-numeric: tabular-nums;
  }
  .st__pbody { display: grid; }
  .st__pbody b { font-weight: 600; font-size: var(--step--1); }
  .st__pnote { font-size: 11px; color: var(--fg-700); }
  .st__drawings {
    margin: 1.25rem 0 0; font-size: 10px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--fg-700);
  }
</style>

<script>
  import { project, faceNormal, shade, headlight, mix, facesCamera, type Camera, type Vec3 } from './board3d';

  interface PackedPart {
    id: string; name: string;
    mm: number; source: number; tris: number;
    v: number[]; f: number[];
  }

  const root = document.querySelector<HTMLElement>('[data-st]');
  if (root) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const chips = root.querySelector<HTMLElement>('[data-parts]')!;
    const loadNote = root.querySelector<HTMLElement>('[data-loadnote]')!;
    const nameOut = root.querySelector<HTMLElement>('[data-part-name]')!;
    const kindOut = root.querySelector<HTMLElement>('[data-part-kind]')!;
    const blurbOut = root.querySelector<HTMLElement>('[data-part-blurb]')!;
    const copy: Record<string, { kind: string; blurb: string }> = JSON.parse(root.dataset.partsCopy!);
    const spinBtn = root.querySelector<HTMLButtonElement>('[data-spin]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;

    const cam: Camera = { azimuth: -30, elevation: 24, scale: 1, cx: 0, cy: 0 };
    let part: PackedPart | null = null;
    let verts: Vec3[] = [];
    let spinning = true;
    let visible = false;
    let raf = 0;

    function loadPart(p: PackedPart, quant: number) {
      part = p;
      verts = [];
      for (let i = 0; i < p.v.length; i += 3) {
        verts.push({ x: p.v[i] / quant, y: p.v[i + 1] / quant, z: p.v[i + 2] / quant });
      }
      // Names come from Maykon's own files and stay as they are; what the part
      // is gets described in the reader's language.
      const said = copy[p.id] ?? { kind: '', blurb: '' };
      nameOut.textContent = p.name;
      kindOut.textContent = said.kind;
      blurbOut.textContent = said.blurb;
      out('mm').textContent = `${p.mm} mm`;
      out('tris').textContent = p.tris.toLocaleString();
      out('src').textContent = p.source.toLocaleString();
      draw();
    }

    function draw() {
      const w = canvas.width, h = canvas.height;
      ctx.clearRect(0, 0, w, h);
      if (!part) return;

      cam.cx = w / 2;
      cam.cy = h / 2;
      cam.scale = Math.min(w, h) * 0.46;   // parts are packed into [-1, 1]
      const lamp = headlight(cam);

      const faces: { depth: number; pts: { sx: number; sy: number }[]; colour: string }[] = [];
      for (let i = 0; i < part.f.length; i += 3) {
        const a = verts[part.f[i]], b = verts[part.f[i + 1]], c = verts[part.f[i + 2]];
        const n = faceNormal(a, b, c);
        if (!n || !facesCamera(n, cam)) continue;
        const pa = project(a, cam), pb = project(b, cam), pc = project(c, cam);
        faces.push({
          depth: (pa.depth + pb.depth + pc.depth) / 3,
          pts: [pa, pb, pc],
          colour: mix('#c9ccd4', shade(n, 0.28, lamp)),
        });
      }

      faces.sort((x, y) => x.depth - y.depth);
      for (const f of faces) {
        ctx.beginPath();
        ctx.moveTo(f.pts[0].sx, f.pts[0].sy);
        ctx.lineTo(f.pts[1].sx, f.pts[1].sy);
        ctx.lineTo(f.pts[2].sx, f.pts[2].sy);
        ctx.closePath();
        ctx.fillStyle = f.colour;
        ctx.fill();
        // Painting a hairline of the same colour closes the seams that
        // antialiasing leaves between adjacent triangles.
        ctx.strokeStyle = f.colour;
        ctx.lineWidth = 0.6;
        ctx.stroke();
      }
    }

    function tick() {
      if (!visible) { raf = 0; return; }
      if (spinning) { cam.azimuth += 0.32; draw(); }
      raf = requestAnimationFrame(tick);
    }

    function start() {
      if (!raf) { raf = requestAnimationFrame(tick); }
    }

    // --- drag ---
    let dragging = false, lastX = 0, lastY = 0;
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      spinning = false;
      spinBtn.setAttribute('aria-pressed', 'false');
      lastX = e.clientX; lastY = e.clientY;
      try { canvas.setPointerCapture(e.pointerId); } catch { /* not ours to capture */ }
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      cam.azimuth -= (e.clientX - lastX) * 0.5;
      cam.elevation = Math.max(-89, Math.min(89, cam.elevation - (e.clientY - lastY) * 0.4));
      lastX = e.clientX; lastY = e.clientY;
      draw();
    });
    const end = () => { dragging = false; };
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);

    spinBtn.addEventListener('click', () => {
      spinning = !spinning;
      spinBtn.setAttribute('aria-pressed', String(spinning));
      start();
    });

    // The meshes are 87 KB, so they are only fetched once someone gets here.
    let loaded = false;
    async function ensureLoaded() {
      if (loaded) return;
      loaded = true;
      try {
        const res = await fetch(`/models/agrom-parts.json?v=${root!.dataset.modelVersion}`);
        const data: { quant: number; parts: PackedPart[] } = await res.json();
        loadNote.remove();
        data.parts.forEach((p, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn mono';
          btn.textContent = p.name;
          btn.setAttribute('aria-pressed', String(i === 0));
          btn.addEventListener('click', () => {
            chips.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
            loadPart(p, data.quant);
          });
          chips.append(btn);
        });
        loadPart(data.parts[0], data.quant);
        start();
      } catch {
        loadNote.textContent = '—';
      }
    }

    new IntersectionObserver((entries) => {
      for (const e of entries) {
        visible = e.isIntersecting;
        if (visible) { ensureLoaded(); start(); }
      }
    }, { threshold: 0.15 }).observe(root);
  }
</script>
