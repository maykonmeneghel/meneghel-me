---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { Content } from '../../content';
import { ASSEMBLIES } from './assembly';
import boms from '../../data/agrom-boms.json';

interface Props { steel: Content['steel'] }
const { steel } = Astro.props;

// Meshes live in public/, which the bundler never fingerprints, while the deploy
// marks non-HTML immutable for a year. Hash the contents so an update reaches a
// returning visitor.
const modelPath = join(process.cwd(), 'public/models/agrom-parts.json');
const modelVersion = createHash('sha256').update(readFileSync(modelPath)).digest('hex').slice(0, 8);

const bomOf = (id: string) => {
  const key = ASSEMBLIES.find((a) => a.id === id)?.bom;
  return key ? (boms as Record<string, { qty: number; unit: string; part: string; supplier?: string }[]>)[key] ?? [] : [];
};
---
<div class="st" data-st
  data-model-version={modelVersion}
  data-products={JSON.stringify(steel.products)}
  data-boms={JSON.stringify(Object.fromEntries(ASSEMBLIES.map((a) => [a.id, bomOf(a.id)])))}
  data-l-none={steel.bomNone}
>
  <p class="st__lede">{steel.lede}</p>

  <div class="st__row">
    <span class="st__rowlabel mono">{steel.productLabel}</span>
    <div class="st__chips">
      {ASSEMBLIES.map((a, i) => (
        <button type="button" class="btn mono" data-product={a.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {steel.products[a.id]?.name ?? a.id}
        </button>
      ))}
    </div>
  </div>

  <div class="st__split">
    <div>
      <div class="st__stage">
        <canvas class="st__canvas" data-canvas width="900" height="900"
          role="img" aria-label="A product from the AGROM.IO station, in three dimensions"></canvas>
        <p class="st__loading mono" data-loading>{steel.loading}</p>
      </div>

      <div class="controls st__controls">
        <label class="control">
          <span class="control__label">{steel.explode} <b data-out="explode">0%</b></span>
          <input type="range" min="0" max="100" step="1" value="0" data-explode />
        </label>
        <label class="control">
          <span class="control__label">{steel.zoom} <b data-out="zoom">100%</b></span>
          <input type="range" min="60" max="600" step="10" value="100" data-zoom />
        </label>
        <div class="st__actions">
          <button type="button" class="btn" data-spin aria-pressed="true">↻ {steel.autoSpin}</button>
          <span class="st__spin mono">↔ {steel.spin}</span>
          <button type="button" class="btn" data-reset>{steel.reset}</button>
        </div>
      </div>

      <p class="st__caption">
        <b data-part-name></b><span data-part-kind></span>
        <span class="st__blurb" data-part-blurb></span>
      </p>

      <div class="readout">
        <div class="readout__cell">
          <span class="readout__k">{steel.pieces}</span>
          <span class="readout__v" data-out="pieces">—</span>
        </div>
        <div class="readout__cell">
          <span class="readout__k">{steel.span}</span>
          <span class="readout__v" data-out="mm">—</span>
        </div>

      </div>
    </div>

    <div class="st__side">
      <p class="st__bomtitle mono">{steel.bomTitle}</p>
      <table class="st__table">
        <thead>
          <tr><th>{steel.bomQty}</th><th>{steel.bomPart}</th><th>{steel.bomSupplier}</th></tr>
        </thead>
        <tbody data-bombody></tbody>
      </table>
      <p class="st__bomempty" data-bomempty hidden></p>
    </div>
  </div>

  <p class="st__prov">{steel.provenance}</p>

  <div class="st__process">
    <h3 class="st__ptitle">{steel.processTitle}</h3>
    <p class="st__plede">{steel.processLede}</p>
    <ul class="st__plist">
      {steel.processes.map((p) => (
        <li class="st__pitem">
          <span class="st__pcount mono">{p.count}</span>
          <span class="st__pbody">
            <b>{p.label}</b>
            <span class="st__pnote">{p.note}</span>
          </span>
        </li>
      ))}
    </ul>
    <p class="st__drawings mono">{steel.drawings}</p>
  </div>
</div>

<style>
  .st__lede { color: var(--fg-500); font-size: var(--step--1); margin: 0 0 1.25rem; max-width: 74ch; }
  .st__row { display: flex; flex-wrap: wrap; gap: .6rem; align-items: baseline; margin-bottom: 1.25rem; }
  .st__rowlabel { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fg-700); min-width: 4.5rem; }
  .st__chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .st__chips .btn { font-size: 11px; padding: .3rem .6rem; }

  .st__split { display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1fr) minmax(0, 300px); align-items: start; }
  @media (max-width: 820px) { .st__split { grid-template-columns: 1fr; } }

  .st__stage { position: relative; background: #06070a; border: 1px solid var(--line); border-radius: 8px; display: grid; place-items: center; }
  .st__canvas { width: 100%; max-width: 460px; height: auto; display: block; cursor: grab; touch-action: pan-y; }
  .st__canvas:active { cursor: grabbing; }
  .st__loading { position: absolute; font-size: 11px; color: var(--fg-700); }

  .st__controls { margin-top: 1rem; }
  .st__actions { display: flex; align-items: center; gap: .8rem; }
  .st__spin { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fg-700); }

  .st__caption { margin: 1rem 0 0; font-size: var(--step--1); color: var(--fg-500); max-width: 56ch; }
  .st__caption b { color: var(--fg-100); font-weight: 600; display: block; }
  .st__blurb { display: block; margin-top: .15rem; }

  .st__side { border: 1px solid var(--line); border-radius: 8px; padding: .9rem; background: var(--bg-900); }
  /* BOM rows are built by the script, so they never carry Astro's scoping
     attribute and the component's own CSS would not reach them. */
  .st__table :global(td) { padding: .3rem 0; vertical-align: top; border-bottom: 1px solid color-mix(in oklab, var(--line) 55%, transparent); }
  .st__table :global(td:first-child) { font-family: var(--font-mono); color: var(--brand-500); white-space: nowrap; padding-right: .6rem; }
  .st__table :global(td:nth-child(2)) { color: var(--fg-300); }
  .st__table :global(td:last-child) { color: var(--fg-700); padding-left: .6rem; }
  .st__bomempty { font-size: var(--step--1); color: var(--fg-700); margin: 0; }

  .st__prov { margin: 1.25rem 0 0; font-size: var(--step--1); color: var(--warn); opacity: .85; max-width: 74ch; }

  .st__process { margin-top: 2.5rem; padding-top: 1.75rem; border-top: 1px solid var(--line); }
  .st__ptitle { font-size: var(--step-1); margin-bottom: .4rem; }
  .st__plede { color: var(--fg-300); font-size: var(--step--1); margin: 0 0 1.25rem; max-width: 70ch; }
  .st__plist { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .st__pitem { display: flex; align-items: baseline; gap: .9rem; }
  .st__pcount { min-width: 2.4rem; text-align: right; font-size: var(--step-1); color: var(--brand-500); font-variant-numeric: tabular-nums; }
  .st__pbody { display: grid; }
  .st__pbody b { font-weight: 600; font-size: var(--step--1); }
  .st__pnote { font-size: 11px; color: var(--fg-700); }
  .st__drawings { margin: 1.25rem 0 0; font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fg-700); }
</style>

<script>
  import { project, faceNormal, facesCamera, shade, headlight, mix, type Camera, type Vec3 } from './board3d';
  import { place, bounds, type Mesh } from './solid';
  import { ASSEMBLIES, buildAssembly, type Piece, type AssemblyId } from './assembly';

  const root = document.querySelector<HTMLElement>('[data-st]');
  if (root) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const loading = root.querySelector<HTMLElement>('[data-loading]')!;
    const explodeIn = root.querySelector<HTMLInputElement>('[data-explode]')!;
    const zoomIn = root.querySelector<HTMLInputElement>('[data-zoom]')!;
    const spinBtn = root.querySelector<HTMLButtonElement>('[data-spin]')!;
    const bomBody = root.querySelector<HTMLElement>('[data-bombody]')!;

    const bomEmpty = root.querySelector<HTMLElement>('[data-bomempty]')!;
    const nameOut = root.querySelector<HTMLElement>('[data-part-name]')!;
    const kindOut = root.querySelector<HTMLElement>('[data-part-kind]')!;
    const blurbOut = root.querySelector<HTMLElement>('[data-part-blurb]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;

    type Copy = { name: string; kind: string; blurb: string };
    type BomLine = { qty: number; unit: string; part: string; supplier?: string };
    const copy: Record<string, Copy> = JSON.parse(root.dataset.products!);
    const boms: Record<string, BomLine[]> = JSON.parse(root.dataset.boms!);

    const cam: Camera = { azimuth: -34, elevation: 18, scale: 1, cx: 0, cy: 0 };
    /** Printed parts, once their STLs have arrived. */
    let stls: Record<string, { mesh: Mesh; mm: number }> = {};
    let current: AssemblyId = 'station';
    let pieces: Piece[] = [];
    let spinning = true;
    let visible = false;
    let raf = 0;

    interface Drawable { verts: Vec3[]; faces: number[]; colour: string; explode: Vec3 }
    let drawables: Drawable[] = [];
    let radius = 1;
    let centre: Vec3 = { x: 0, y: 0, z: 0 };

    function meshOf(p: Piece): Mesh | null {
      if (p.mesh) return p.mesh;
      if (!p.stl) return null;
      const part = stls[p.stl];
      if (!part) return null;
      // STLs arrive normalised to span 2 on their longest axis; mm restores them.
      const scale = part.mm / 2;
      const at = p.at ?? { x: 0, y: 0, z: 0 };
      return {
        v: part.mesh.v.map((v, i) => v * scale + (i % 3 === 0 ? at.x : i % 3 === 1 ? at.y : at.z)),
        f: part.mesh.f,
      };
    }

    function load(id: AssemblyId) {
      current = id;
      pieces = buildAssembly(id);
      drawables = [];
      for (const p of pieces) {
        const mesh = meshOf(p);
        if (!mesh) continue;
        const verts: Vec3[] = [];
        for (let i = 0; i < mesh.v.length; i += 3) {
          verts.push({ x: mesh.v[i], y: mesh.v[i + 1], z: mesh.v[i + 2] });
        }
        drawables.push({ verts, faces: mesh.f, colour: p.colour, explode: p.explode });
      }

      // Fit to the exploded extent so nothing leaves the frame when pulled apart.
      const all: Mesh[] = drawables.map((d) => ({
        v: d.verts.flatMap((v) => [v.x + d.explode.x, v.y + d.explode.y, v.z + d.explode.z]),
        f: [],
      }));
      const b = bounds({ v: all.flatMap((m) => m.v), f: [] });
      centre = { x: (b.lo[0] + b.hi[0]) / 2, y: (b.lo[1] + b.hi[1]) / 2, z: (b.lo[2] + b.hi[2]) / 2 };
      radius = Math.max(...b.size) / 2 || 1;

      const said = copy[id] ?? { name: id, kind: '', blurb: '' };
      nameOut.textContent = said.name;
      kindOut.textContent = said.kind;
      blurbOut.textContent = said.blurb;

      const assembled = bounds({ v: drawables.flatMap((d) => d.verts.flatMap((v) => [v.x, v.y, v.z])), f: [] });
      out('pieces').textContent = String(pieces.length);
      out('mm').textContent = `${Math.round(Math.max(...assembled.size))} mm`;

      renderBom(id);
      draw();
    }

    function renderBom(id: AssemblyId) {
      const lines = boms[id] ?? [];
      bomBody.replaceChildren();
      bomEmpty.hidden = lines.length > 0;
      if (!lines.length) {
        bomEmpty.textContent = root!.dataset.lNone!;
        return;
      }
      for (const line of lines) {
        const tr = document.createElement('tr');
        for (const text of [`${line.qty} ${line.unit}`.trim(), line.part, line.supplier ?? '']) {
          const td = document.createElement('td');
          td.textContent = text;
          tr.append(td);
        }
        bomBody.append(tr);
      }
    }

    function draw() {
      const w = canvas.width, h = canvas.height;
      ctx.clearRect(0, 0, w, h);
      if (!drawables.length) return;
      cam.cx = w / 2;
      cam.cy = h / 2;
      cam.scale = ((Math.min(w, h) * 0.44) / radius) * (Number(zoomIn.value) / 100);
      const lamp = headlight(cam);
      const t = Number(explodeIn.value) / 100;

      const faces: { depth: number; pts: { sx: number; sy: number }[]; colour: string }[] = [];
      for (const d of drawables) {
        const dx = d.explode.x * t - centre.x;
        const dy = d.explode.y * t - centre.y;
        const dz = d.explode.z * t - centre.z;
        for (let i = 0; i < d.faces.length; i += 3) {
          const a = d.verts[d.faces[i]], b = d.verts[d.faces[i + 1]], c = d.verts[d.faces[i + 2]];
          const n = faceNormal(a, b, c);
          if (!n || !facesCamera(n, cam)) continue;
          const shift = (v: Vec3) => ({ x: v.x + dx, y: v.y + dy, z: v.z + dz });
          const pa = project(shift(a), cam), pb = project(shift(b), cam), pc = project(shift(c), cam);
          faces.push({
            depth: (pa.depth + pb.depth + pc.depth) / 3,
            pts: [pa, pb, pc],
            colour: mix(d.colour, shade(n, 0.3, lamp)),
          });
        }
      }
      faces.sort((x, y) => x.depth - y.depth);
      for (const f of faces) {
        ctx.beginPath();
        ctx.moveTo(f.pts[0].sx, f.pts[0].sy);
        ctx.lineTo(f.pts[1].sx, f.pts[1].sy);
        ctx.lineTo(f.pts[2].sx, f.pts[2].sy);
        ctx.closePath();
        ctx.fillStyle = f.colour;
        ctx.fill();
        ctx.strokeStyle = f.colour;
        ctx.lineWidth = 0.6;
        ctx.stroke();
      }
    }

    function tick() {
      if (!visible) { raf = 0; return; }
      if (spinning) { cam.azimuth += 0.3; draw(); }
      raf = requestAnimationFrame(tick);
    }
    const start = () => { if (!raf) raf = requestAnimationFrame(tick); };

    explodeIn.addEventListener('input', () => {
      out('explode').textContent = `${explodeIn.value}%`;
      draw();
    });
    zoomIn.addEventListener('input', () => {
      out('zoom').textContent = `${zoomIn.value}%`;
      draw();
    });

    const setZoom = (next: number) => {
      const min = Number(zoomIn.min), max = Number(zoomIn.max);
      const clamped = Math.max(min, Math.min(max, next));
      const changed = clamped !== Number(zoomIn.value);
      zoomIn.value = String(Math.round(clamped));
      out('zoom').textContent = `${zoomIn.value}%`;
      if (changed) draw();
      return changed;
    };

    // The wheel zooms, but only while it has somewhere to go. At either limit it
    // lets the page scroll on, so nobody gets trapped in the viewer.
    canvas.addEventListener('wheel', (e) => {
      const factor = e.deltaY < 0 ? 1.12 : 1 / 1.12;
      if (setZoom(Number(zoomIn.value) * factor)) e.preventDefault();
    }, { passive: false });

    canvas.addEventListener('dblclick', () => {
      cam.azimuth = -34;
      cam.elevation = 18;
      setZoom(100);
      explodeIn.value = '0';
      out('explode').textContent = '0%';
      draw();
    });
    root.querySelector<HTMLButtonElement>('[data-reset]')!.addEventListener('click', () => {
      canvas.dispatchEvent(new MouseEvent('dblclick'));
    });
    spinBtn.addEventListener('click', () => {
      spinning = !spinning;
      spinBtn.setAttribute('aria-pressed', String(spinning));
      start();
    });
    root.querySelectorAll<HTMLButtonElement>('[data-product]').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('[data-product]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        load(btn.dataset.product as AssemblyId);
      });
    });

    let dragging = false, lastX = 0, lastY = 0;
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true; spinning = false;
      spinBtn.setAttribute('aria-pressed', 'false');
      lastX = e.clientX; lastY = e.clientY;
      try { canvas.setPointerCapture(e.pointerId); } catch { /* not ours to capture */ }
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      cam.azimuth -= (e.clientX - lastX) * 0.5;
      cam.elevation = Math.max(-89, Math.min(89, cam.elevation - (e.clientY - lastY) * 0.4));
      lastX = e.clientX; lastY = e.clientY;
      draw();
    });
    const end = () => { dragging = false; };
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);

    let loaded = false;
    async function ensureLoaded() {
      if (loaded) return;
      loaded = true;
      try {
        const res = await fetch(`/models/agrom-parts.json?v=${root!.dataset.modelVersion}`);
        const data = await res.json();
        for (const p of data.parts) {
          stls[p.id] = {
            mm: p.mm,
            mesh: { v: p.v.map((n: number) => n / data.quant), f: p.f },
          };
        }
      } catch {
        // The turned parts still render; only the printed ones are missing.
      }
      loading.hidden = true;
      load(current);
      start();
    }

    new IntersectionObserver((entries) => {
      for (const e of entries) {
        visible = e.isIntersecting;
        if (visible) { ensureLoaded(); start(); }
      }
    }, { threshold: 0.15 }).observe(root);
  }
</script>
