---
import type { Content } from '../../content';
interface Props { mind: Content['mind'] }
const { mind } = Astro.props;
---
<div class="gn" data-gn
  data-l-real={mind.real}
  data-l-generated={mind.generated}
  data-l-critic={mind.criticSays}
  data-hint-start={mind.hintStart}
  data-hint-right={mind.hintRight}
  data-hint-wrong={mind.hintWrong}
  data-hint-low={mind.hintLow}
  data-hint-high={mind.hintHigh}
  data-hint-his={mind.hintHis}
  data-verdict={mind.verdict}
>
  <p class="gn__lede">{mind.lede}</p>
  <p class="gn__paper mono">{mind.paper}</p>

  <p class="gn__q">{mind.question}</p>

  <div class="gn__pair">
    <button type="button" class="gn__panel" data-slot="a" aria-label={`${mind.pick} ${mind.slotA}`}>
      <span class="gn__head">
        <span class="gn__slot mono">{mind.slotA}</span>
        <span class="gn__reading mono">{mind.reading}</span>
      </span>
      <canvas class="gn__chart" data-chart="a" width="720" height="380"></canvas>
      <span class="gn__verdictline mono" data-verdict-a>&nbsp;</span>
    </button>
    <button type="button" class="gn__panel" data-slot="b" aria-label={`${mind.pick} ${mind.slotB}`}>
      <span class="gn__head">
        <span class="gn__slot mono">{mind.slotB}</span>
        <span class="gn__reading mono">{mind.reading}</span>
      </span>
      <canvas class="gn__chart" data-chart="b" width="720" height="380"></canvas>
      <span class="gn__verdictline mono" data-verdict-b>&nbsp;</span>
    </button>
  </div>

  <div class="gn__bar">
    <button type="button" class="btn btn--primary" data-next disabled>{mind.next}</button>
    <button type="button" class="btn" data-reset>{mind.reset}</button>
  </div>

  <div class="readout">
    <div class="readout__cell">
      <span class="readout__k">{mind.rounds}</span>
      <span class="readout__v" data-out="rounds">0</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{mind.you}</span>
      <span class="readout__v" data-out="you">—</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{mind.network}</span>
      <span class="readout__v" data-out="net">—</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{mind.fooled}</span>
      <span class="readout__v" data-out="fooled">—</span>
    </div>
  </div>

  <p class="gn__hint" data-hint>{mind.hintStart}</p>

  <div class="gn__lambda">
    <label class="gn__lambdahead" for="gn-lambda">
      <span class="gn__lambdalabel">{mind.lambdaLabel}</span>
      <span class="gn__lambdaval mono" data-out="lambda">0.60</span>
    </label>
    <input id="gn-lambda" class="gn__slider" type="range" min="0" max="1" step="0.05" value="0.6" data-lambda />
    <span class="gn__ticks mono">
      <span>1 − λ · MSE</span>
      <span>λ · critic</span>
      <span class="gn__tickhis" data-his>{mind.lambdaHis} · 0.60</span>
    </span>

    <div class="gn__meters">
      <div class="gn__meter">
        <span class="gn__meterk">{mind.meterTruth}</span>
        <span class="gn__track"><i data-meter="truth" style="width:38%"></i></span>
        <span class="gn__meterv mono" data-out="mape">—</span>
      </div>
      <div class="gn__meter">
        <span class="gn__meterk">{mind.meterReal}</span>
        <span class="gn__track"><i class="gn__fill--alt" data-meter="real" style="width:55%"></i></span>
        <span class="gn__meterv mono" data-out="spread">—</span>
      </div>
    </div>
  </div>

  <div class="gn__arch">
    <span class="gn__archk mono">{mind.arch}</span>
    <code class="gn__archline">{mind.archGen}</code>
    <code class="gn__archline">{mind.archDisc}</code>
    <p class="gn__archnote">{mind.archNote}</p>
  </div>
</div>

<style>
  .gn__lede { color: var(--fg-500); font-size: var(--step-body); margin: 0 0 .5rem; max-width: 74ch; }
  .gn__paper {
    margin: 0 0 1.5rem; font-size: 10px; letter-spacing: .16em;
    text-transform: uppercase; color: var(--fg-700);
  }
  .gn__q { margin: 0 0 .9rem; font-size: var(--step-0); color: var(--fg-100); }

  .gn__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 720px) { .gn__pair { grid-template-columns: 1fr; } }

  .gn__panel {
    display: flex; flex-direction: column; gap: .55rem;
    background: #06070a; border: 1px solid var(--line); border-radius: 10px;
    padding: .8rem .8rem .65rem; cursor: pointer; text-align: left;
    font: inherit; color: inherit; transition: border-color .15s, background .15s;
  }
  .gn__panel:hover:not([data-state]) { border-color: var(--fg-500); }
  .gn__panel:focus-visible { outline: 2px solid var(--brand-500); outline-offset: 2px; }
  .gn__panel[data-state] { cursor: default; }
  .gn__panel[data-state="real"] { border-color: var(--ok); }
  .gn__panel[data-state="fake"] { border-color: var(--fail); }
  .gn__head { display: flex; justify-content: space-between; gap: .75rem; align-items: baseline; }
  .gn__slot { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fg-700); }
  .gn__reading { font-size: 10px; color: var(--fg-700); opacity: .75; }
  @media (max-width: 420px) { .gn__reading { display: none; } }
  .gn__chart { width: 100%; height: auto; display: block; }
  .gn__verdictline { font-size: 11px; min-height: 1.3em; color: var(--fg-500); }
  .gn__panel[data-state="real"] .gn__verdictline { color: var(--ok); }
  .gn__panel[data-state="fake"] .gn__verdictline { color: var(--fail); }

  .gn__bar { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1.1rem; }
  .gn__hint { margin-top: 1rem; font-size: var(--step-body); color: var(--fg-300); max-width: 74ch; min-height: 3em; }

  .gn__lambda {
    margin-top: 1.75rem; padding: 1.15rem 1.25rem 1.3rem;
    border: 1px solid var(--line); border-radius: 10px; background: var(--bg-800);
  }
  .gn__lambdahead { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .gn__lambdalabel { font-size: var(--step--1); color: var(--fg-300); }
  .gn__lambdaval { font-size: var(--step-1); color: var(--brand-500); }
  .gn__slider { width: 100%; margin: .7rem 0 .35rem; accent-color: var(--brand-500); }
  /* No uppercase here: text-transform would turn the lambda into a capital one,
     and the whole point of the row is that it names the two halves of the loss. */
  .gn__ticks {
    position: relative; display: flex; justify-content: space-between;
    gap: .5rem; padding-bottom: 1.2rem;
    font-size: 10px; letter-spacing: .06em; color: var(--fg-700);
  }
  /* Parked at 60% of the track rather than in the middle of the row, because
     0.6 is a specific setting and the middle would say 0.5. */
  .gn__tickhis {
    position: absolute; top: 1.15em; left: 60%; transform: translateX(-50%);
    white-space: nowrap; color: var(--brand-500);
  }
  .gn__tickhis[data-off] { color: var(--fg-700); }

  .gn__meters { display: grid; gap: .55rem; margin-top: 1.1rem; }
  .gn__meter { display: grid; grid-template-columns: 14rem 1fr 5.5rem; gap: .75rem; align-items: center; }
  @media (max-width: 560px) { .gn__meter { grid-template-columns: 1fr; gap: .25rem; } }
  .gn__meterk { font-size: var(--step--1); color: var(--fg-500); }
  .gn__track { display: block; height: 6px; border-radius: 3px; background: var(--bg-600); overflow: hidden; }
  .gn__track > i { display: block; height: 100%; background: var(--ok); transition: width .18s; }
  .gn__track > i.gn__fill--alt { background: var(--brand-500); }
  .gn__meterv { font-size: 11px; color: var(--fg-500); text-align: right; }

  .gn__arch { margin-top: 1.5rem; display: grid; gap: .4rem; }
  .gn__archk { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fg-700); }
  .gn__archline {
    font-family: var(--font-mono); font-size: 11px; color: var(--fg-300);
    background: var(--bg-800); border: 1px solid var(--line);
    border-radius: 6px; padding: .45rem .6rem; overflow-x: auto; white-space: pre;
  }
  .gn__archnote { margin: .35rem 0 0; font-size: var(--step-body); color: var(--fg-700); max-width: 74ch; }
</style>

<script>
  import { CONFIG, series, round, critic, sweep, type Round } from './gan';

  const root = document.querySelector<HTMLElement>('[data-gn]');
  if (root) {
    const L = {
      real: root.dataset.lReal!,
      generated: root.dataset.lGenerated!,
      critic: root.dataset.lCritic!,
      start: root.dataset.hintStart!,
      right: root.dataset.hintRight!,
      wrong: root.dataset.hintWrong!,
      low: root.dataset.hintLow!,
      high: root.dataset.hintHigh!,
      his: root.dataset.hintHis!,
      verdict: root.dataset.verdict!,
    };

    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const panels = {
      a: root.querySelector<HTMLButtonElement>('[data-slot="a"]')!,
      b: root.querySelector<HTMLButtonElement>('[data-slot="b"]')!,
    };
    const charts = {
      a: root.querySelector<HTMLCanvasElement>('[data-chart="a"]')!,
      b: root.querySelector<HTMLCanvasElement>('[data-chart="b"]')!,
    };
    const lines = {
      a: root.querySelector<HTMLElement>('[data-verdict-a]')!,
      b: root.querySelector<HTMLElement>('[data-verdict-b]')!,
    };
    const slider = root.querySelector<HTMLInputElement>('[data-lambda]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;

    const css = getComputedStyle(document.documentElement);
    const paint = {
      line: css.getPropertyValue('--fg-300').trim() || '#c8ccd4',
      dim: css.getPropertyValue('--fg-700').trim() || '#5a606c',
      brand: css.getPropertyValue('--brand-500').trim() || '#ff2d55',
      ok: css.getPropertyValue('--ok').trim() || '#3ddc97',
      fail: css.getPropertyValue('--fail').trim() || '#ff5c5c',
    };

    // One long path, walked forward a window at a time. Six thousand bars is
    // more rounds than anyone will sit through.
    const SEED = 20210901;
    const source = series(6000, SEED);
    // The meters read off a fixed sweep, so moving the slider is instant.
    const grid = Array.from({ length: 21 }, (_, i) => sweep(i / 20, 300, SEED));
    const mapes = grid.map((g) => g.mape);
    const worst = Math.max(...mapes);
    const best = Math.min(...mapes);

    let lambda = CONFIG.lambda;
    let index = 0;
    let current: Round | null = null;
    let answered = true;
    const tally = { played: 0, you: 0, net: 0, fooled: 0 };

    function drawWindow(canvas: HTMLCanvasElement, history: number[], last: number,
                        lo: number, hi: number, tone: string | null) {
      const ctx = canvas.getContext('2d')!;
      const { width: w, height: h } = canvas;
      ctx.clearRect(0, 0, w, h);

      const padX = 26, padTop = 22, padBottom = 26;
      const closes = [...history, last];
      const span = Math.max(hi - lo, 1e-9);
      const x = (i: number) => padX + (i / (closes.length - 1)) * (w - padX * 2);
      const y = (v: number) => padTop + (1 - (v - lo) / span) * (h - padTop - padBottom);

      // A faint grid, so the eye has something to measure the last step against.
      ctx.strokeStyle = 'rgba(255,255,255,.05)';
      ctx.lineWidth = 1;
      for (let g = 0; g <= 4; g++) {
        const gy = padTop + (g / 4) * (h - padTop - padBottom);
        ctx.beginPath(); ctx.moveTo(padX, gy); ctx.lineTo(w - padX, gy); ctx.stroke();
      }

      // The nine bars that really happened.
      ctx.strokeStyle = paint.line;
      ctx.lineWidth = 2.5;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      history.forEach((v, i) => (i === 0 ? ctx.moveTo(x(i), y(v)) : ctx.lineTo(x(i), y(v))));
      ctx.stroke();

      for (let i = 0; i < history.length; i++) {
        ctx.fillStyle = paint.dim;
        ctx.beginPath(); ctx.arc(x(i), y(history[i]), 2.6, 0, Math.PI * 2); ctx.fill();
      }

      // The tenth, which is the entire question.
      const n = history.length;
      ctx.strokeStyle = tone ?? paint.brand;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(x(n - 1), y(history[n - 1]));
      ctx.lineTo(x(n), y(last));
      ctx.stroke();
      ctx.fillStyle = tone ?? paint.brand;
      ctx.beginPath(); ctx.arc(x(n), y(last), 4.5, 0, Math.PI * 2); ctx.fill();

      // A dashed rule where the history stops and the candidate starts.
      ctx.save();
      ctx.setLineDash([3, 4]);
      ctx.strokeStyle = 'rgba(255,255,255,.14)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x(n - 1), padTop - 8); ctx.lineTo(x(n - 1), h - padBottom + 8);
      ctx.stroke();
      ctx.restore();
    }

    function render() {
      if (!current) return;
      const { history, real, fake, realIsA } = current;
      // Both panels share one vertical scale. If they did not, the axis labels
      // would answer the question before the chart did.
      const all = [...history, real, fake];
      const lo = Math.min(...all), hi = Math.max(...all);
      const pad = (hi - lo) * 0.18 || 1;
      const inA = realIsA ? real : fake;
      const inB = realIsA ? fake : real;
      const toneOf = (isReal: boolean) => (answered ? (isReal ? paint.ok : paint.fail) : null);
      drawWindow(charts.a, history, inA, lo - pad, hi + pad, toneOf(realIsA));
      drawWindow(charts.b, history, inB, lo - pad, hi + pad, toneOf(!realIsA));
    }

    function newRound() {
      // Windows are taken thirteen bars apart so consecutive rounds do not
      // overlap and give the previous answer away.
      const at = 12 + index * 13;
      current = round(source, at % (source.length - CONFIG.windowSize - 1), lambda, SEED + index * 7919);
      index++;
      answered = false;
      for (const p of [panels.a, panels.b]) { delete p.dataset.state; p.disabled = false; }
      lines.a.innerHTML = '&nbsp;';
      lines.b.innerHTML = '&nbsp;';
      nextBtn.disabled = true;
      render();
    }

    function answer(slot: 'a' | 'b') {
      if (!current || answered) return;
      answered = true;
      const { history, real, fake, realIsA } = current;
      const pRealSide = critic(history, real);
      const pFakeSide = critic(history, fake);
      const youRight = (slot === 'a') === realIsA;
      const netRight = pRealSide > pFakeSide;

      tally.played++;
      if (youRight) tally.you++;
      if (netRight) tally.net++;
      if (pFakeSide > 0.5) tally.fooled++;

      const realPanel = realIsA ? panels.a : panels.b;
      const fakePanel = realIsA ? panels.b : panels.a;
      const realLine = realIsA ? lines.a : lines.b;
      const fakeLine = realIsA ? lines.b : lines.a;
      realPanel.dataset.state = 'real';
      fakePanel.dataset.state = 'fake';
      realLine.textContent = `${L.real} · ${L.critic} ${pRealSide.toFixed(2)}`;
      fakeLine.textContent = `${L.generated} · ${L.critic} ${pFakeSide.toFixed(2)}`;
      for (const p of [panels.a, panels.b]) p.disabled = true;

      out('rounds').textContent = String(tally.played);
      out('you').textContent = `${Math.round((tally.you / tally.played) * 100)}%`;
      out('net').textContent = `${Math.round((tally.net / tally.played) * 100)}%`;
      out('fooled').textContent = `${Math.round((tally.fooled / tally.played) * 100)}%`;

      const base = youRight ? L.right : L.wrong;
      const tail = tally.played >= 6
        ? ' ' + L.verdict
            .replace('{you}', `${Math.round((tally.you / tally.played) * 100)}%`)
            .replace('{net}', `${Math.round((tally.net / tally.played) * 100)}%`)
        : '';
      hint.textContent = base + tail;
      hint.dataset.tone = youRight ? 'done' : '';
      nextBtn.disabled = false;
      render();
    }

    function updateLambda() {
      lambda = Number(slider.value);
      out('lambda').textContent = lambda.toFixed(2);
      const g = grid[Math.round(lambda * 20)];
      const truth = Math.round(100 * (1 - (g.mape - best) / Math.max(worst - best, 1e-9)));
      const real = Math.min(100, Math.round(g.spread * 100));
      root.querySelector<HTMLElement>('[data-meter="truth"]')!.style.width = `${truth}%`;
      root.querySelector<HTMLElement>('[data-meter="real"]')!.style.width = `${real}%`;
      out('mape').textContent = `${g.mape.toFixed(2)}% MAPE`;
      out('spread').textContent = `${(g.spread * 100).toFixed(0)}% σ`;
      const his = root.querySelector<HTMLElement>('[data-his]')!;
      if (Math.abs(lambda - CONFIG.lambda) < 0.001) delete his.dataset.off;
      else his.dataset.off = '';
      hint.textContent = lambda <= 0.2 ? L.low : lambda >= 0.9 ? L.high
        : Math.abs(lambda - CONFIG.lambda) < 0.001 ? L.his : hint.textContent;
      if (!answered) newRoundInPlace();
    }

    // Changing lambda mid-round would be unfair to the player, so it redraws the
    // same window with a fresh candidate rather than jumping to a new one.
    function newRoundInPlace() {
      if (!current) return;
      const at = 12 + (index - 1) * 13;
      current = round(source, at % (source.length - CONFIG.windowSize - 1), lambda, SEED + (index - 1) * 7919);
      render();
    }

    panels.a.addEventListener('click', () => answer('a'));
    panels.b.addEventListener('click', () => answer('b'));
    nextBtn.addEventListener('click', newRound);
    slider.addEventListener('input', updateLambda);
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      tally.played = tally.you = tally.net = tally.fooled = 0;
      index = 0;
      for (const k of ['rounds', 'you', 'net', 'fooled']) {
        out(k).textContent = k === 'rounds' ? '0' : '—';
      }
      hint.textContent = L.start;
      delete hint.dataset.tone;
      newRound();
    });

    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        updateLambda();
        hint.textContent = L.start;
        newRound();
      }
    }, { rootMargin: '200px' });
    io.observe(root);
  }
</script>
