---
import type { Content } from '../../content';
interface Props { mind: Content['mind'] }
const { mind } = Astro.props;
---
<div class="pc" data-pc
  data-hint-place={mind.hintPlace}
  data-hint-converged={mind.hintConverged}
  data-hint-stuck={mind.hintStuck}
  data-l-train={mind.train}
  data-l-pause={mind.pause}
>
  <p class="pc__lede">{mind.lede}</p>

  <div class="pc__plotwrap">
    <canvas class="pc__plot" data-plot width="880" height="560"
      role="img" aria-label="Decision boundary over temperature and vibration"></canvas>
    <span class="pc__axis pc__axis--x mono">{mind.axisX}</span>
    <span class="pc__axis pc__axis--y mono">{mind.axisY}</span>
  </div>

  <div class="pc__bar">
    <div class="pc__classpick">
      <span class="pc__classlabel mono">{mind.adding}</span>
      <button type="button" class="btn pc__cls pc__cls--ok" data-class="1" aria-pressed="true">
        <i class="pc__dot pc__dot--ok"></i>{mind.healthy}
      </button>
      <button type="button" class="btn pc__cls pc__cls--bad" data-class="-1" aria-pressed="false">
        <i class="pc__dot pc__dot--bad"></i>{mind.failing}
      </button>
    </div>
    <div class="pc__actions">
      <button type="button" class="btn btn--primary" data-train>{mind.train}</button>
      <button type="button" class="btn" data-preset="separable">{mind.presetSeparable}</button>
      <button type="button" class="btn" data-preset="xor">{mind.presetXor}</button>
      <button type="button" class="btn" data-clear>{mind.clear}</button>
    </div>
  </div>

  <div class="readout">
    <div class="readout__cell">
      <span class="readout__k">{mind.steps}</span>
      <span class="readout__v" data-out="steps">0</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{mind.accuracy}</span>
      <span class="readout__v" data-out="acc">—</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{mind.wrong}</span>
      <span class="readout__v" data-out="wrong">0</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{mind.weights}</span>
      <span class="readout__v pc__w" data-out="weights">0.00, 0.00, 0.00</span>
    </div>
  </div>

  <p class="pc__hint" data-hint>{mind.hintPlace}</p>
</div>

<style>
  .pc__lede { color: var(--fg-500); font-size: var(--step--1); margin: 0 0 1.25rem; max-width: 72ch; }

  .pc__plotwrap { position: relative; padding-left: 1.4rem; padding-bottom: 1.2rem; }
  .pc__plot {
    width: 100%; height: auto; border-radius: 8px;
    background: #06070a; border: 1px solid var(--line);
    cursor: crosshair; touch-action: manipulation;
  }
  .pc__axis {
    position: absolute; font-size: 10px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--fg-700);
  }
  .pc__axis--x { bottom: 0; left: 50%; transform: translateX(-50%); }
  .pc__axis--y { left: 0; top: 50%; transform: rotate(-90deg) translateX(50%); transform-origin: left center; }

  .pc__bar {
    display: flex; flex-wrap: wrap; gap: 1.25rem;
    justify-content: space-between; align-items: center; margin-top: 1.25rem;
  }
  .pc__classpick, .pc__actions { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .pc__classlabel {
    font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fg-700);
  }
  .pc__cls { display: inline-flex; align-items: center; gap: .45rem; }
  .pc__cls[aria-pressed="true"] { background: var(--bg-600); border-color: var(--fg-500); color: var(--fg-100); }
  .pc__dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  .pc__dot--ok  { background: var(--ok); }
  .pc__dot--bad { background: var(--fail); }

  .pc__w { font-size: var(--step-0) !important; }
  .pc__hint { margin-top: 1rem; font-size: var(--step--1); color: var(--fg-300); max-width: 72ch; min-height: 3em; }
  .pc__hint[data-tone="stuck"] { color: var(--warn); }
  .pc__hint[data-tone="done"]  { color: var(--ok); }
</style>

<script>
  import {
    zeroWeights, randomWeights, trainStep, accuracy, mistakes, boundary, predict,
    SEPARABLE, XOR, type Point, type Weights,
  } from './perceptron';

  const root = document.querySelector<HTMLElement>('[data-pc]');
  if (root) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-plot]')!;
    const ctx = canvas.getContext('2d')!;
    const trainBtn = root.querySelector<HTMLButtonElement>('[data-train]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const classBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-class]')];
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;

    const L = {
      place: root.dataset.hintPlace!,
      converged: root.dataset.hintConverged!,
      stuck: root.dataset.hintStuck!,
      train: root.dataset.lTrain!,
      pause: root.dataset.lPause!,
    };

    /**
     * Past this many corrections without converging, the data is not separable.
     * Measured: over 500 random starts the separable set never needed more than
     * 53, so this cannot fire falsely — and at 70ms a step it reaches the reader
     * in about six seconds rather than a minute.
     */
    const STUCK_AFTER = 90;
    const STEP_MS = 70;

    let points: Point[] = SEPARABLE.map((p) => ({ ...p }));
    let w: Weights = randomWeights();
    let steps = 0;
    let flash: number | null = null;
    let adding: 1 | -1 = 1;
    let training = false;
    let acc = 0;
    let visible = false;

    const toPx = (x: number, y: number) => [
      ((x + 1) / 2) * canvas.width,
      ((1 - y) / 2) * canvas.height,   // canvas y grows downward; the plot does not
    ];
    const toWorld = (px: number, py: number) => [
      (px / canvas.width) * 2 - 1,
      1 - (py / canvas.height) * 2,
    ];

    function reset(next: Point[]) {
      points = next.map((p) => ({ ...p }));
      // A fresh random start, so each run searches from somewhere different.
      w = next.length ? randomWeights() : zeroWeights();
      steps = 0;
      flash = null;
      setTraining(false);
      setHint(L.place, '');
      render();
    }

    function setTraining(on: boolean) {
      training = on;
      trainBtn.textContent = on ? L.pause : L.train;
      trainBtn.setAttribute('aria-pressed', String(on));
    }

    function setHint(text: string, tone: string) {
      hint.textContent = text;
      if (tone) hint.dataset.tone = tone; else delete hint.dataset.tone;
    }

    function tick() {
      const next = trainStep(w, points);
      if (next.correctedIndex === null) {
        setTraining(false);
        flash = null;
        // Converged means: nothing left that it gets wrong. Not a step budget.
        if (points.length) setHint(L.converged, 'done');
        return;
      }
      w = next.weights;
      flash = next.correctedIndex;
      steps++;
      if (steps > STUCK_AFTER && acc < 1) setHint(L.stuck, 'stuck');
    }

    function render() {
      const wpx = canvas.width, hpx = canvas.height;
      ctx.clearRect(0, 0, wpx, hpx);

      // Shade what the model would answer everywhere, not just where the data is.
      const CELL = 20;
      for (let px = 0; px < wpx; px += CELL) {
        for (let py = 0; py < hpx; py += CELL) {
          const [x, y] = toWorld(px + CELL / 2, py + CELL / 2);
          const healthy = predict(w, { x, y }) === 1;
          ctx.fillStyle = healthy ? 'rgba(52,211,153,.05)' : 'rgba(244,63,94,.05)';
          ctx.fillRect(px, py, CELL, CELL);
        }
      }

      ctx.strokeStyle = '#12151c'; ctx.lineWidth = 1;
      for (let g = 1; g < 4; g++) {
        ctx.beginPath(); ctx.moveTo((wpx / 4) * g, 0); ctx.lineTo((wpx / 4) * g, hpx); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, (hpx / 4) * g); ctx.lineTo(wpx, (hpx / 4) * g); ctx.stroke();
      }

      const line = boundary(w);
      if (line) {
        const [a, b] = line;
        const [ax, ay] = toPx(a[0], a[1]);
        const [bx, by] = toPx(b[0], b[1]);
        ctx.beginPath(); ctx.moveTo(ax, ay); ctx.lineTo(bx, by);
        ctx.strokeStyle = '#ff2d55'; ctx.lineWidth = 3;
        ctx.shadowColor = 'rgba(255,45,85,.55)'; ctx.shadowBlur = 10;
        ctx.stroke(); ctx.shadowBlur = 0;
      }

      points.forEach((p, i) => {
        const [px, py] = toPx(p.x, p.y);
        const good = predict(w, p) === p.label;
        const colour = p.label === 1 ? '#34d399' : '#f43f5e';

        // Anything still misclassified wears a ring: those are the only points
        // the next correction can possibly come from.
        if (!good) {
          ctx.beginPath(); ctx.arc(px, py, 15, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(251,191,36,.85)'; ctx.lineWidth = 2;
          ctx.setLineDash([3, 3]); ctx.stroke(); ctx.setLineDash([]);
        }
        if (i === flash) {
          ctx.beginPath(); ctx.arc(px, py, 22, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(251,191,36,.22)'; ctx.fill();
        }

        ctx.beginPath(); ctx.arc(px, py, 8, 0, Math.PI * 2);
        ctx.fillStyle = colour; ctx.fill();
        ctx.strokeStyle = '#06070a'; ctx.lineWidth = 2.5; ctx.stroke();
      });

      acc = accuracy(w, points);
      const wrong = mistakes(w, points).length;
      out('steps').textContent = String(steps);
      out('acc').textContent = points.length ? `${Math.round(acc * 100)}%` : '—';
      out('acc').dataset.state = acc === 1 ? 'ok' : acc < 0.75 ? 'fail' : 'warn';
      out('wrong').textContent = String(wrong);
      out('wrong').dataset.state = wrong === 0 ? 'ok' : 'warn';
      out('weights').textContent =
        `${w.w1.toFixed(2)}, ${w.w2.toFixed(2)}, ${w.b.toFixed(2)}`;
    }

    canvas.addEventListener('click', (e) => {
      const box = canvas.getBoundingClientRect();
      const px = ((e.clientX - box.left) / box.width) * canvas.width;
      const py = ((e.clientY - box.top) / box.height) * canvas.height;
      const [x, y] = toWorld(px, py);
      points.push({ x, y, label: adding });
      // New evidence invalidates the old verdict, so retract it.
      if (hint.dataset.tone === 'done') setHint(L.place, '');
      render();
    });

    classBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        adding = Number(btn.dataset.class) as 1 | -1;
        classBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      });
    });

    trainBtn.addEventListener('click', () => {
      if (!points.length) return;
      setTraining(!training);
      if (training) { setHint(L.place, ''); last = performance.now(); }
    });
    root.querySelector('[data-clear]')!.addEventListener('click', () => reset([]));
    root.querySelector('[data-preset="separable"]')!.addEventListener('click', () => reset(SEPARABLE));
    root.querySelector('[data-preset="xor"]')!.addEventListener('click', () => reset(XOR));

    let last = performance.now();
    let acc2 = 0;
    function frame(now: number) {
      if (!visible) return;
      if (training) {
        acc2 += now - last;
        while (acc2 >= STEP_MS) { tick(); acc2 -= STEP_MS; }
        render();
      }
      last = now;
      requestAnimationFrame(frame);
    }

    render();
    new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && !visible) {
          visible = true; last = performance.now(); acc2 = 0;
          requestAnimationFrame(frame);
        } else if (!e.isIntersecting) {
          visible = false;
        }
      }
    }, { threshold: 0.15 }).observe(root);
  }
</script>
