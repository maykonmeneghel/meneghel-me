---
import type { Content } from '../../content';
import { DEFAULT_STATE, ACCENTS } from './screen';

interface Props { glass: Content['glass'] }
const { glass } = Astro.props;
---
<div class="gl" data-gl data-note={glass.note} data-swift-android={glass.swiftOnAndroid}>
  <p class="gl__lede">{glass.lede}</p>

  <div class="gl__controls">
    <div class="gl__group">
      <span class="gl__label mono">{glass.accent}</span>
      {(Object.keys(ACCENTS) as (keyof typeof ACCENTS)[]).map((k) => (
        <button type="button" class="gl__swatch" data-accent={k}
          aria-pressed={k === DEFAULT_STATE.accent ? 'true' : 'false'}
          style={`--sw:${ACCENTS[k].css}`} aria-label={k}></button>
      ))}
    </div>
    <div class="gl__group">
      <span class="gl__label mono">{glass.layout}</span>
      <button type="button" class="btn gl__chip" data-layout="stacked" aria-pressed="true">{glass.stacked}</button>
      <button type="button" class="btn gl__chip" data-layout="inline" aria-pressed="false">{glass.inline}</button>
    </div>
    <div class="gl__group">
      <span class="gl__label mono">{glass.device}</span>
      <button type="button" class="btn gl__chip" data-device="ios" aria-pressed="true">{glass.iphone}</button>
      <button type="button" class="btn gl__chip" data-device="android" aria-pressed="false">{glass.android}</button>
    </div>
    <label class="control gl__radius">
      <span class="control__label">{glass.radius} <b data-out="radius">{DEFAULT_STATE.radius}</b></span>
      <input type="range" min="0" max="32" step="1" value={DEFAULT_STATE.radius} data-radius />
    </label>
  </div>

  <div class="gl__stage">
    <div class="gl__phone" data-phone data-device="ios">
      <div class="gl__chrome" aria-hidden="true">
        <span class="gl__notch"></span>
        <span class="gl__punch"></span>
      </div>
      <div class="gl__status mono" aria-hidden="true">
        <span>09:41</span>
        <span class="gl__statusicons"><i></i><i></i><i></i></span>
      </div>

      <div class="gl__screen">
        <div class="gl__card" data-card>
          <div class="gl__head" data-gap>
            <span class="gl__sensor mono">{glass.card.sensor}</span>
            <span class="gl__time mono">{glass.card.age}</span>
          </div>

          <div class="gl__valuerow" data-gap>
            <span class="gl__value">43<i>%</i></span>
            <span class="gl__delta mono">▲ {glass.card.delta}</span>
          </div>

          <span class="gl__pill" data-gap><i class="gl__dot"></i>{glass.card.status}</span>

          <svg class="gl__chartsvg" data-gap data-chartsvg viewBox="0 0 200 48" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="glFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" class="gl__fillTop" />
                <stop offset="100%" class="gl__fillBottom" />
              </linearGradient>
            </defs>
            <path class="gl__area" d="M0,36 22,31 44,37 66,24 88,29 110,15 132,20 154,10 176,15 200,6 200,48 0,48 Z" fill="url(#glFill)" />
            <polyline class="gl__line" points="0,36 22,31 44,37 66,24 88,29 110,15 132,20 154,10 176,15 200,6" />
            <circle class="gl__lastdot" cx="200" cy="6" r="3" />
          </svg>

          <div class="gl__divider" data-gap></div>

          <div class="gl__stats" data-gap>
            <div><b>{glass.card.depth}</b><span class="mono">{glass.card.depthLabel}</span></div>
            <div><b>{glass.card.soil}</b><span class="mono">{glass.card.soilLabel}</span></div>
          </div>
        </div>
      </div>

      <span class="gl__bar" aria-hidden="true"></span>
    </div>

    <div class="gl__code">
      <div class="gl__tabs">
        <button type="button" class="btn gl__tab" data-fw="swift" aria-pressed="true">SwiftUI</button>
        <button type="button" class="btn gl__tab" data-fw="dart" aria-pressed="false">Flutter</button>
        <span class="gl__file mono" data-file>ReadingCard.swift</span>
      </div>
      <p class="gl__unavailable mono" data-unavailable hidden></p>
      <pre class="gl__pre mono"><code data-code></code></pre>
    </div>
  </div>

  <p class="takeaway gl__note">
    <b>{glass.noteTitle} → </b><span data-note-text></span>
  </p>
</div>

<style>
  .gl__lede { color: var(--fg-500); font-size: var(--step-body); margin: 0 0 1.25rem; max-width: 74ch; }

  .gl__controls { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; margin-bottom: 1.5rem; }
  .gl__group { display: flex; align-items: center; gap: .45rem; }
  .gl__label { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fg-700); }
  .gl__chip { font-size: 11px; padding: .3rem .6rem; }
  .gl__radius { max-width: 200px; flex: 1 1 160px; }
  .gl__swatch {
    width: 20px; height: 20px; border-radius: 50%; cursor: pointer;
    background: var(--sw); border: 2px solid transparent; box-shadow: 0 0 0 1px var(--line-2);
  }
  .gl__swatch[aria-pressed="true"] { border-color: var(--bg-900); box-shadow: 0 0 0 2px var(--sw); }

  .gl__stage { display: grid; gap: 1.5rem; grid-template-columns: minmax(230px, 268px) 1fr; align-items: start; }
  @media (max-width: 800px) { .gl__stage { grid-template-columns: 1fr; justify-items: center; } }

  /* ---- the phone ---- */
  .gl__phone {
    position: relative; width: 100%; max-width: 268px; aspect-ratio: 9 / 17.5;
    padding: 11px; background: #0a0c11;
    border: 2px solid #232833;
    box-shadow: inset 0 0 0 5px #05060a, 0 24px 60px -30px rgba(0, 0, 0, .9);
    display: grid; grid-template-rows: auto 1fr auto;
    transition: border-radius .28s ease;
  }
  /* The chrome is the tell: a soft-cornered slab with an island, or a squarer
     one with a punch-hole. Nobody needs a label to know which is which. */
  .gl__phone[data-device="ios"] { border-radius: 42px; }
  .gl__phone[data-device="android"] { border-radius: 26px; }

  .gl__chrome { position: absolute; inset: 11px 11px auto; height: 34px; pointer-events: none; }
  .gl__notch {
    position: absolute; top: 6px; left: 50%; transform: translateX(-50%);
    width: 78px; height: 20px; border-radius: 999px; background: #05060a;
    transition: opacity .2s, width .28s ease;
  }
  .gl__punch {
    position: absolute; top: 9px; left: 50%; transform: translateX(-50%);
    width: 9px; height: 9px; border-radius: 50%; background: #05060a;
    box-shadow: 0 0 0 1px #1b1f27;
  }
  .gl__phone[data-device="ios"] .gl__punch { opacity: 0; }
  .gl__phone[data-device="android"] .gl__notch { opacity: 0; width: 0; }

  .gl__status {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 9px; color: var(--fg-500); padding: 0 .55rem;
    height: 34px;
  }
  .gl__phone[data-device="android"] .gl__status { justify-content: space-between; }
  .gl__statusicons { display: flex; gap: 3px; }
  .gl__statusicons i { width: 7px; height: 7px; border-radius: 1.5px; background: var(--fg-700); display: block; }
  .gl__phone[data-device="ios"] .gl__statusicons i:last-child { border-radius: 2px; width: 12px; }

  .gl__screen { padding: .35rem .4rem; align-self: start; }

  /* ---- the card ---- */
  .gl__card {
    display: grid; justify-items: stretch;
    padding: 18px;
    border-radius: var(--gl-radius, 18px);
    background:
      linear-gradient(150deg, rgba(255,255,255,.075), rgba(255,255,255,.018) 60%),
      #12151c;
    border: 1px solid rgba(255,255,255,.09);
    box-shadow: 0 18px 40px -28px rgba(0,0,0,.9);
    transition: border-radius .18s, gap .2s;
  }
  .gl__card [data-gap] + [data-gap] { margin-top: var(--gl-gap, 14px); }

  .gl__head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
  .gl__sensor { font-size: 9.5px; letter-spacing: .04em; color: var(--fg-500); }
  .gl__time {
    font-size: 9px; color: var(--fg-700);
    padding: .12rem .38rem; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.08);
  }

  .gl__valuerow { display: flex; align-items: baseline; gap: .5rem; }
  .gl__value {
    font-size: var(--gl-font, 44px); font-weight: 600; line-height: 1;
    letter-spacing: -0.03em; color: var(--gl-accent, #ff2d55);
  }
  .gl__value i {
    font-size: .42em; font-style: normal; margin-left: 2px;
    color: color-mix(in oklab, var(--gl-accent, #ff2d55) 55%, transparent);
  }
  .gl__delta {
    margin-left: auto; font-size: 9.5px;
    color: var(--ok); padding: .14rem .4rem; border-radius: 999px;
    background: color-mix(in oklab, var(--ok) 14%, transparent);
  }

  .gl__pill {
    justify-self: start;
    display: inline-flex; align-items: center; gap: .35rem;
    font-size: 9px; letter-spacing: .1em; text-transform: uppercase;
    padding: .22rem .5rem .22rem .4rem; border-radius: 999px;
    color: var(--ok); border: 1px solid color-mix(in oklab, var(--ok) 40%, transparent);
    background: color-mix(in oklab, var(--ok) 8%, transparent);
  }
  .gl__dot {
    width: 5px; height: 5px; border-radius: 50%; background: var(--ok);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--ok) 70%, transparent);
    animation: gl-pulse 2.4s infinite;
  }
  @keyframes gl-pulse { 70% { box-shadow: 0 0 0 5px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

  .gl__chartsvg { width: 100%; height: 48px; display: block; }
  .gl__fillTop { stop-color: var(--gl-accent, #ff2d55); stop-opacity: .30; }
  .gl__fillBottom { stop-color: var(--gl-accent, #ff2d55); stop-opacity: 0; }
  .gl__line {
    fill: none; stroke: var(--gl-accent, #ff2d55);
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .gl__lastdot { fill: var(--gl-accent, #ff2d55); stroke: #12151c; stroke-width: 2; }

  .gl__divider { height: 1px; background: rgba(255,255,255,.07); }

  .gl__stats { display: flex; gap: 1.1rem; }
  .gl__stats div { display: grid; gap: .1rem; }
  .gl__stats b { font-size: 12px; font-weight: 600; color: var(--fg-100); }
  .gl__stats span { font-size: 8.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-700); }

  /* Inline drops the chart, the divider and the footer, and lays the rest across. */
  .gl__card[data-layout="inline"] .gl__chartsvg,
  .gl__card[data-layout="inline"] .gl__divider,
  .gl__card[data-layout="inline"] .gl__stats { display: none; }
  .gl__card[data-layout="inline"] {
    display: flex; flex-wrap: wrap; align-items: baseline;
    gap: var(--gl-gap, 12px);
  }
  .gl__card[data-layout="inline"] [data-gap] + [data-gap] { margin-top: 0; }
  .gl__card[data-layout="inline"] .gl__head { flex: 1 1 100%; }
  .gl__card[data-layout="inline"] .gl__valuerow { flex: 1 1 auto; min-width: 0; }
  .gl__card[data-layout="inline"] .gl__pill { flex: 0 0 auto; }

  .gl__bar {
    justify-self: center; align-self: end;
    width: 96px; height: 4px; border-radius: 999px;
    background: #2b303b; margin-bottom: 2px;
    transition: width .28s ease, border-radius .28s ease;
  }
  .gl__phone[data-device="android"] .gl__bar { width: 64px; height: 3px; }

  /* ---- code ---- */
  .gl__code { min-width: 0; width: 100%; }
  .gl__tabs { display: flex; gap: .4rem; align-items: center; margin-bottom: .6rem; }
  .gl__tab { font-size: 11px; padding: .3rem .7rem; }
  .gl__tab:disabled { opacity: .35; cursor: not-allowed; }
  .gl__file { margin-left: auto; font-size: 10px; color: var(--fg-700); }
  .gl__unavailable {
    margin: 0 0 .6rem; font-size: var(--step--1); color: var(--warn);
    padding: .5rem .7rem; border-radius: 6px;
    background: color-mix(in oklab, var(--warn) 9%, transparent);
  }
  .gl__pre {
    margin: 0; padding: 1rem; overflow-x: auto;
    background: #06070a; border: 1px solid var(--line); border-radius: 8px;
    font-size: 11.5px; line-height: 1.6; color: var(--fg-300);
    max-height: 520px; overflow-y: auto;
  }
  .gl__pre :global(.k) { color: #ff7a9c; }
  .gl__pre :global(.t) { color: #7dd3fc; }
  .gl__pre :global(.s) { color: #86efac; }
  .gl__pre :global(.n) { color: #fbbf24; }
  .gl__pre :global(.c) { color: var(--fg-700); font-style: italic; }

  .gl__note { margin-top: 1.5rem; }
</style>

<script>
  import {
    swiftUI, flutter, spacingOf, spacerCount, fontOf, hasChart, ACCENTS, DEFAULT_STATE,
    type ScreenState, type Accent, type Layout,
  } from './screen';

  const root = document.querySelector<HTMLElement>('[data-gl]');
  if (root) {
    const codeOut = root.querySelector<HTMLElement>('[data-code]')!;
    const fileOut = root.querySelector<HTMLElement>('[data-file]')!;
    const card = root.querySelector<HTMLElement>('[data-card]')!;
    const phone = root.querySelector<HTMLElement>('[data-phone]')!;
    const radiusOut = root.querySelector<HTMLElement>('[data-out="radius"]')!;
    const noteOut = root.querySelector<HTMLElement>('[data-note-text]')!;
    const unavailable = root.querySelector<HTMLElement>('[data-unavailable]')!;
    const swiftTab = root.querySelector<HTMLButtonElement>('[data-fw="swift"]')!;
    const dartTab = root.querySelector<HTMLButtonElement>('[data-fw="dart"]')!;
    const noteTpl = root.dataset.note!;

    const state: ScreenState = { ...DEFAULT_STATE };
    let framework: 'swift' | 'dart' = 'swift';
    let device: 'ios' | 'android' = 'ios';

    const KEYWORDS: Record<'swift' | 'dart', RegExp> = {
      swift: /(?:struct|let|var|some|body|in|return|func|self)\b/y,
      dart: /(?:class|extends|const|final|required|super|this|return|build|override)\b/y,
    };

    const escape = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    /**
     * Single pass with sticky patterns, rather than chained replaces: a chain
     * lets a later rule match the markup an earlier one just inserted.
     */
    function highlight(code: string, lang: 'swift' | 'dart'): string {
      const rules: [string | null, RegExp][] = [
        ['c', /\/\/[^\n]*/y],
        ['s', /'(?:[^'\\\n]|\\.)*'|"(?:[^"\\\n]|\\.)*"/y],
        ['n', /0x[0-9A-Fa-f]+|\d+(?:\.\d+)?/y],
        ['k', KEYWORDS[lang]],
        [null, /[a-z_$][A-Za-z0-9_]*/y],
        ['t', /[A-Z][A-Za-z0-9_]*/y],
      ];
      let out = '';
      let i = 0;
      while (i < code.length) {
        let matched = false;
        for (const [cls, re] of rules) {
          re.lastIndex = i;
          const m = re.exec(code);
          if (m && m.index === i && m[0].length > 0) {
            out += cls ? `<span class="${cls}">${escape(m[0])}</span>` : escape(m[0]);
            i += m[0].length;
            matched = true;
            break;
          }
        }
        if (!matched) { out += escape(code[i]); i += 1; }
      }
      return out;
    }

    function render() {
      card.style.setProperty('--gl-radius', `${state.radius}px`);
      card.style.setProperty('--gl-gap', `${spacingOf(state.layout)}px`);
      card.style.setProperty('--gl-font', `${fontOf(state.layout)}px`);
      card.style.setProperty('--gl-accent', ACCENTS[state.accent].css);
      card.dataset.layout = state.layout;
      phone.dataset.device = device;
      radiusOut.textContent = String(state.radius);

      const code = framework === 'swift' ? swiftUI(state) : flutter(state);
      fileOut.textContent = framework === 'swift' ? 'ReadingCard.swift' : 'reading_card.dart';
      codeOut.innerHTML = highlight(code, framework);
      noteOut.textContent = noteTpl.replace('{n}', String(spacerCount(state).dart));
    }

    /** SwiftUI does not run on Android. Saying so is the point of the toggle. */
    function applyDevice() {
      const blocked = device === 'android';
      swiftTab.disabled = blocked;
      unavailable.hidden = !blocked;
      if (blocked) {
        unavailable.textContent = root!.dataset.swiftAndroid!;
        if (framework === 'swift') {
          framework = 'dart';
          swiftTab.setAttribute('aria-pressed', 'false');
          dartTab.setAttribute('aria-pressed', 'true');
        }
      }
      render();
    }

    const press = (sel: string, on: (el: HTMLElement) => boolean) => {
      root.querySelectorAll<HTMLElement>(sel).forEach((el) => el.setAttribute('aria-pressed', String(on(el))));
    };

    root.querySelectorAll<HTMLButtonElement>('[data-accent]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.accent = btn.dataset.accent as Accent;
        press('[data-accent]', (el) => el === btn);
        render();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-layout]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.layout = btn.dataset.layout as Layout;
        press('[data-layout]', (el) => el === btn);
        render();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-device]').forEach((btn) => {
      btn.addEventListener('click', () => {
        device = btn.dataset.device as 'ios' | 'android';
        press('[data-device]', (el) => el === btn);
        applyDevice();
      });
    });

    root.querySelector<HTMLInputElement>('[data-radius]')!.addEventListener('input', (e) => {
      state.radius = Number((e.target as HTMLInputElement).value);
      render();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-fw]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        framework = btn.dataset.fw as 'swift' | 'dart';
        press('[data-fw]', (el) => el === btn);
        render();
      });
    });

    // Keeps the preview honest: the chart is a property of the arrangement.
    void hasChart;
    applyDevice();
  }
</script>
