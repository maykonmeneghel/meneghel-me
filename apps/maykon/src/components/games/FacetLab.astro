---
import type { Content } from '../../content';
import { SOURCES, TOLERANCES_MM } from './usdz';

interface Props { facet: Content['facet'] }
const { facet } = Astro.props;
---
<div class="fc" data-fc
  data-warnings={JSON.stringify(facet.warnings)}
  data-materials={JSON.stringify(facet.materials)}
  data-l-clean={facet.cleanNote}
  data-l-person={facet.personLabel}
  data-l-baked={facet.toleranceBaked}
>
  <p class="fc__lede">{facet.lede}</p>

  <div class="fc__row">
    <span class="fc__rowk mono">{facet.sourceLabel}</span>
    {SOURCES.map((s, i) => (
      <button type="button" class="btn fc__s" data-source={s} aria-pressed={i === 0 ? 'true' : 'false'}>
        {facet.sources[s]}
      </button>
    ))}
  </div>

  <div class="fc__row">
    <span class="fc__rowk mono">{facet.transformLabel}</span>
    <button type="button" class="btn fc__x" data-fix="axis" aria-pressed="true">{facet.axisBtn}</button>
    <button type="button" class="btn fc__x" data-fix="units" aria-pressed="true">{facet.unitsBtn}</button>
  </div>

  <div class="fc__row">
    <span class="fc__rowk mono">{facet.toleranceLabel}</span>
    {TOLERANCES_MM.map((t, i) => (
      <button type="button" class="btn fc__t" data-tol={t} aria-pressed={i === 2 ? 'true' : 'false'}>{t} mm</button>
    ))}
    <span class="fc__baked mono" data-baked hidden>{facet.toleranceBaked}</span>
  </div>

  <canvas class="fc__view" data-view width="960" height="300"
    role="img" aria-label="The converted part, in a room, at the size and orientation it lands"></canvas>

  <div class="readout">
    <div class="readout__cell">
      <span class="readout__k">{facet.heightLabel}</span>
      <span class="readout__v" data-out="height">—</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{facet.trianglesLabel}</span>
      <span class="readout__v" data-out="tris">—</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{facet.sizeLabel}</span>
      <span class="readout__v" data-out="size">—</span>
    </div>
    <div class="readout__cell">
      <span class="readout__k">{facet.materialLabel}</span>
      <span class="readout__v" data-out="material">—</span>
    </div>
  </div>

  <ul class="fc__warn" data-warn></ul>
</div>

<style>
  .fc__lede { color: var(--fg-500); font-size: var(--step-body); margin: 0 0 1.25rem; }

  .fc__row { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-bottom: .9rem; }
  .fc__rowk {
    font-size: 10px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--fg-700); min-width: 7.5rem;
  }
  .fc__s[aria-pressed="true"], .fc__t[aria-pressed="true"] {
    background: var(--bg-600); border-color: var(--brand-500); color: var(--fg-100);
  }
  .fc__t { font-size: 11px; padding: .32rem .6rem; }
  /* A transform that is switched off is the mistake, so it reads as one. */
  .fc__x[aria-pressed="true"] { background: var(--bg-600); border-color: var(--ok); color: var(--fg-100); }
  .fc__x[aria-pressed="false"] { border-color: color-mix(in oklab, var(--fail) 60%, transparent); color: var(--fail); }
  .fc__t:disabled { opacity: .35; cursor: not-allowed; }
  .fc__baked { font-size: 10px; color: var(--fg-700); }

  .fc__view {
    width: 100%; height: auto; display: block; margin: 1.25rem 0 1.1rem;
    border: 1px solid var(--line); border-radius: 8px; background: var(--bg-900);
  }

  .fc__warn { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: .45rem; }
  .fc__warn li {
    font-size: var(--step-body); color: var(--fg-300);
    padding-left: 1.1rem; position: relative;
  }
  .fc__warn li::before {
    content: '!'; position: absolute; left: 0; top: 0;
    font-family: var(--font-mono); color: var(--warn);
  }
  .fc__warn li[data-tone="fail"] { color: var(--fail); }
  .fc__warn li[data-tone="fail"]::before { color: var(--fail); }
  .fc__warn li[data-tone="ok"] { color: var(--ok); }
  .fc__warn li[data-tone="ok"]::before { content: '✓'; color: var(--ok); }
</style>

<script>
  import {
    FORMATS, SOURCES, TOLERANCES_MM, PART_HEIGHT_MM, convert,
    type Source, type Conversion, type Warning,
  } from './usdz';

  const root = document.querySelector<HTMLElement>('[data-fc]');
  if (root) {
    const view = root.querySelector<HTMLCanvasElement>('[data-view]')!;
    const ctx = view.getContext('2d')!;
    const warnOut = root.querySelector<HTMLElement>('[data-warn]')!;
    const bakedOut = root.querySelector<HTMLElement>('[data-baked]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const warnings: Record<Warning, string> = JSON.parse(root.dataset.warnings!);
    const materials: Record<string, string> = JSON.parse(root.dataset.materials!);

    let source: Source = SOURCES[0];
    let convertAxis = true;
    let convertUnits = true;
    let toleranceMm: number = TOLERANCES_MM[2];

    // The room the part lands in: a floor, and a person to disagree with.
    const GROUND_Y = 262;
    const PERSON_M = 1.7;
    const PX_PER_M = 118;

    function drawPerson(x: number) {
      const h = PERSON_M * PX_PER_M;
      ctx.strokeStyle = 'rgba(148,163,184,.55)';
      ctx.fillStyle = 'rgba(148,163,184,.55)';
      ctx.lineWidth = 2;
      const headR = h * 0.075;
      const top = GROUND_Y - h;
      ctx.beginPath();
      ctx.arc(x, top + headR, headR, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(x, top + headR * 2);
      ctx.lineTo(x, GROUND_Y - h * 0.36);
      ctx.moveTo(x - h * 0.13, top + h * 0.34);
      ctx.lineTo(x + h * 0.13, top + h * 0.34);
      ctx.moveTo(x, GROUND_Y - h * 0.36);
      ctx.lineTo(x - h * 0.11, GROUND_Y);
      ctx.moveTo(x, GROUND_Y - h * 0.36);
      ctx.lineTo(x + h * 0.11, GROUND_Y);
      ctx.stroke();
      ctx.fillStyle = 'rgba(148,163,184,.7)';
      ctx.font = '11px ui-monospace, monospace';
      ctx.textAlign = 'center';
      ctx.fillText(root!.dataset.lPerson!, x, GROUND_Y + 16);
    }

    /** The part itself: a body, a flange and a bore, drawn about its base. */
    function partPath(hPx: number) {
      const w = hPx * 0.55;
      ctx.beginPath();
      ctx.moveTo(-w / 2, 0);
      ctx.lineTo(-w / 2, -hPx * 0.14);
      ctx.lineTo(-w * 0.28, -hPx * 0.2);
      ctx.lineTo(-w * 0.28, -hPx * 0.86);
      ctx.lineTo(-w * 0.4, -hPx);
      ctx.lineTo(w * 0.4, -hPx);
      ctx.lineTo(w * 0.28, -hPx * 0.86);
      ctx.lineTo(w * 0.28, -hPx * 0.2);
      ctx.lineTo(w / 2, -hPx * 0.14);
      ctx.lineTo(w / 2, 0);
      ctx.closePath();
    }

    function draw(c: Conversion) {
      const w = view.width, h = view.height;
      ctx.clearRect(0, 0, w, h);

      ctx.strokeStyle = 'rgba(148,163,184,.25)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, GROUND_Y + 0.5);
      ctx.lineTo(w, GROUND_Y + 0.5);
      ctx.stroke();

      drawPerson(150);

      const heightPx = (c.heightMm / 1000) * PX_PER_M;
      const wrong = c.tiltDeg !== 0 || c.scale !== 1;
      const stroke = wrong ? 'rgba(248,113,113,.9)' : 'rgba(52,211,153,.9)';
      const fillCol = wrong ? 'rgba(248,113,113,.16)' : 'rgba(52,211,153,.16)';

      const EDGE = 300;

      if (heightPx <= GROUND_Y - 34) {
        // It fits in the room, so it is drawn in the room, to scale — tipped
        // over to the right if the axis was never converted, which is the whole
        // reason the person is standing there.
        ctx.save();
        ctx.translate(EDGE, GROUND_Y);
        if (c.tiltDeg !== 0) ctx.rotate((c.tiltDeg * Math.PI) / 180);
        ctx.strokeStyle = stroke;
        ctx.fillStyle = fillCol;
        ctx.lineWidth = 2;
        partPath(heightPx);
        ctx.fill();
        ctx.stroke();
        ctx.restore();
      } else {
        // At this size the part is not an object in a room any more, it is a
        // wall. Drawing it to scale would flood the canvas and read as a change
        // of background, so it is hatched: unmistakably the part, and
        // unmistakably running off the edge.
        ctx.save();
        ctx.beginPath();
        ctx.rect(EDGE, 0, view.width - EDGE, GROUND_Y);
        ctx.clip();
        ctx.fillStyle = 'rgba(248,113,113,.09)';
        ctx.fillRect(EDGE, 0, view.width - EDGE, GROUND_Y);
        ctx.strokeStyle = 'rgba(248,113,113,.3)';
        ctx.lineWidth = 1;
        for (let x = EDGE - GROUND_Y; x < view.width; x += 16) {
          ctx.beginPath();
          ctx.moveTo(x, GROUND_Y);
          ctx.lineTo(x + GROUND_Y, 0);
          ctx.stroke();
        }
        ctx.restore();

        ctx.strokeStyle = 'rgba(248,113,113,.9)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(EDGE, GROUND_Y);
        ctx.lineTo(EDGE, 0);
        ctx.stroke();

        ctx.fillStyle = 'rgba(248,113,113,.95)';
        ctx.font = '600 16px ui-sans-serif, system-ui, sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText(`↑ ${(c.heightMm / 1000).toFixed(0)} m`, EDGE + 16, 30);
      }
    }

    function paint() {
      const f = FORMATS[source];
      const c = convert(source, { convertAxis, convertUnits, toleranceMm });

      // The tolerance is only the author's to choose when the source is a solid.
      const mesh = f.geometry === 'mesh';
      root!.querySelectorAll<HTMLButtonElement>('[data-tol]').forEach((b) => { b.disabled = mesh; });
      bakedOut.hidden = !mesh;

      out('height').textContent = c.scale === 1
        ? `${PART_HEIGHT_MM} mm`
        : `${(c.heightMm / 1000).toFixed(0)} m`;
      out('height').dataset.state = c.scale === 1 ? 'ok' : 'fail';
      out('tris').textContent = c.triangles.toLocaleString();
      out('tris').dataset.state = c.warnings.includes('overBudget') ? 'warn' : 'ok';
      out('size').textContent = `${(c.bytes / 1e6).toFixed(2)} MB`;
      out('material').textContent = materials[c.material];
      out('material').dataset.state = c.material === 'pbr' ? 'ok' : 'warn';

      warnOut.innerHTML = '';
      if (c.warnings.length === 0) {
        const li = document.createElement('li');
        li.dataset.tone = 'ok';
        li.textContent = root!.dataset.lClean!;
        warnOut.append(li);
      } else {
        for (const key of c.warnings) {
          const li = document.createElement('li');
          if (key === 'axis' || key === 'units') li.dataset.tone = 'fail';
          li.textContent = warnings[key];
          warnOut.append(li);
        }
      }

      draw(c);
    }

    root.querySelectorAll<HTMLButtonElement>('[data-source]').forEach((btn) => {
      btn.addEventListener('click', () => {
        source = btn.dataset.source as Source;
        root.querySelectorAll('[data-source]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        paint();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-fix]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const on = btn.getAttribute('aria-pressed') !== 'true';
        btn.setAttribute('aria-pressed', String(on));
        if (btn.dataset.fix === 'axis') convertAxis = on; else convertUnits = on;
        paint();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-tol]').forEach((btn) => {
      btn.addEventListener('click', () => {
        toleranceMm = Number(btn.dataset.tol);
        root.querySelectorAll('[data-tol]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        paint();
      });
    });

    paint();
  }
</script>
