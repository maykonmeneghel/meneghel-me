---
/**
 * The CV, as the page an applicant tracking system wants: one column, real
 * text, headings it recognises, no tables and no two-column layout — those get
 * parsed as interleaved gibberish. It is also the source for the PDF, printed
 * from this route by tools/build-cv.sh.
 */
import { careerItems, ventures, publications, skillGroups } from '../content/career';
import { content } from '../content';

const c = content.en;
const EMAIL = 'maykonmeneghel@icloud.com';
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const when = (d: [number, number] | null) => (d ? `${MONTHS[d[1] - 1]} ${d[0]}` : 'Present');
const ROLES = c.record.roles;

const lanes = [
  { id: 'industry', title: 'Experience' },
  { id: 'venture',  title: 'Ventures' },
  { id: 'research', title: 'Research' },
  { id: 'education', title: 'Education' },
] as const;

const rows = (lane: string) =>
  careerItems
    .filter((i) => i.lane === lane)
    .sort((a, b) => (b.start[0] * 12 + b.start[1]) - (a.start[0] * 12 + a.start[1]));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Maykon Meneghel — Senior Mobile Engineer — CV</title>
    <meta name="description" content="Senior Full-Stack Engineer. Agribusiness and financial markets. Firmware to production models." />
    <meta name="robots" content="noindex" />
    <style>
      @page { size: A4; margin: 11mm 13mm; }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: #fff; color: #14161a;
        font: 9.3pt/1.34 "Helvetica Neue", Helvetica, Arial, sans-serif;
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
      .cv { max-width: 190mm; margin: 0 auto; }
      h1 { font-size: 21pt; margin: 0 0 2pt; letter-spacing: -0.02em; }
      .role { font-size: 11pt; color: #b3123a; font-weight: 600; margin: 0 0 6pt; }
      .contact { font-size: 9pt; color: #3d434d; margin: 0 0 12pt; }
      .contact a { color: #14161a; text-decoration: none; }
      /* No letter-spacing. It renders beautifully and extracts as
         "E D U C AT I O N", and an applicant tracking system finds its sections
         by matching the word. The heading has to survive copy and paste. */
      h2 {
        font-size: 9pt; font-weight: 700; text-transform: uppercase;
        color: #6a7180; margin: 9pt 0 4pt; padding-bottom: 2pt;
        border-bottom: 0.6pt solid #ccd0d8;
      }
      .summary { margin: 0 0 2pt; text-align: justify; }
      .item { margin: 0 0 4.5pt; break-inside: avoid; }
      .item__head { display: flex; justify-content: space-between; gap: 10pt; align-items: baseline; }
      .item__title { font-weight: 600; }
      .item__when { font-size: 8.5pt; color: #6a7180; white-space: nowrap; }
      .item__org { font-size: 9pt; color: #3d434d; }
      .skill { margin: 0 0 4pt; }
      .skill b { display: inline; font-weight: 600; }
      .pub { margin: 0 0 5pt; }
      .pub__meta { font-size: 8.5pt; color: #6a7180; }
      ul { margin: 2pt 0 0; padding-left: 13pt; }
      li { margin-bottom: 3pt; }
      a { color: #14161a; }
    </style>
  </head>
  <body>
    <main class="cv">
      <h1>Maykon Meneghel</h1>
      <p class="role">Senior Mobile Engineer — native iOS, macOS &amp; visionOS, Flutter and the APIs behind them</p>
      <p class="contact">
        Curitiba, Paraná, Brazil ·
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a> ·
        <a href="https://www.linkedin.com/in/maykonmeneghel/">linkedin.com/in/maykonmeneghel</a> ·
        <a href="https://github.com/maykonmeneghel">github.com/maykonmeneghel</a> ·
        <a href="https://apps.apple.com/us/app/tradx/id6743033919">Tradx on the App Store</a> ·
        <a href="https://maykon.meneghel.me">maykon.meneghel.me</a>
      </p>

      <h2>Summary</h2>
      <p class="summary">
        Senior mobile engineer with seven years shipping native Apple platforms in Swift and
        SwiftUI — iOS, macOS and visionOS — and cross-platform in Flutter: Swift Concurrency, MVVM and Clean Architecture, XCTest and
        XCUITest, Dynamic Type, VoiceOver and localisation, fastlane and TestFlight. Two years
        at the Apple Developer Academy and four on a production Apple engagement, promoted from
        trainee to senior on the same product. I build the APIs the apps talk to as well: Node.js,
        NestJS and Java, MongoDB and PostgreSQL, Docker and Kubernetes on AWS. Tradx is my own
        product and my sandbox — a desktop trading client in Flutter, on the Mac App Store and the
        Microsoft Store, with around fifteen thousand downloads between them, built with one other
        engineer on pull requests and reviews. M.Sc. in
        Bioengineering, postgraduate specialization in applied AI, three peer-reviewed papers,
        and current work in Gaussian Splatting.
      </p>

      <h2>Selected Highlights</h2>
      <ul>
        <li><b>Trainee to Senior in four years</b> on the same production Apple engagement
          (2022–2026), each step taken by owning the work nobody wanted: the release process,
          the flaky suite, the screen rewritten twice.</li>
        <li><b>Tradx</b> — my own product and sandbox. A desktop trading client in Flutter, on
          the Mac App Store and the Microsoft Store, ~15,000 downloads between them, from the
          strategy graph to the execution engine. Built with one other engineer, on pull requests,
          with reviews neither of us skips.</li>
        <li><b>Rebuilt the OAuth deep-link flow</b> for Tradx: Universal Links instead of a custom
          scheme, one-time codes with PKCE, and single-use exchange.</li>
        <li><b>Three peer-reviewed papers</b> among six academic works, none of them about mobile — where I learned to
          state a method precisely enough for somebody else to attack it, and to change the claim
          when they did.</li>
      </ul>

      {lanes.map((lane) => (
        <>
          <h2>{lane.title}</h2>
          {rows(lane.id).map((i) => (
            <div class="item">
              <div class="item__head">
                <span class="item__title">{ROLES[i.id]}</span>
                <span class="item__when">{when(i.start)} — {when(i.end)}</span>
              </div>
              <div class="item__org">{i.org}</div>
            </div>
          ))}
        </>
      ))}

      <h2>Technical Skills</h2>
      {skillGroups.map((g) => (
        <p class="skill"><b>{c.record.skills.groups[g.id]}:</b> {g.items.join(', ')}</p>
      ))}

      <h2>Selected Publications</h2>
      {publications.map((p) => (
        <div class="pub">
          <div>{c.record.publications.items[p.id]}</div>
          <div class="pub__meta">
            {p.year} · {p.venue}
            {p.doi && <> · doi:{p.doi}</>}
            {p.url && <> · {p.url.replace('https://', '')}</>}
          </div>
        </div>
      ))}

      <h2>Companies Founded</h2>
      <p class="skill">
        {ventures.map((v, i) => (
          <>{i > 0 && ', '}{v.name} ({c.record.ventures.sectors[v.sector]})</>
        ))}
      </p>

      <h2>Languages</h2>
      <p class="skill">Portuguese (native) · English (professional) · Spanish (professional)</p>
    </main>
  </body>
</html>
